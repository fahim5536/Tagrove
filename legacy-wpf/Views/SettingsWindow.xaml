<ui:FluentWindow x:Class="StockMeta.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="580" MinWidth="580"
                 SizeToContent="Height" MaxHeight="660"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">

    <Grid Margin="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" />

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="Gemini API key" FontWeight="SemiBold" />
            <PasswordBox x:Name="KeyBox" Margin="0,8,0,0" />
            <TextBlock x:Name="KeyHint" Margin="0,6,0,0" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
            <TextBlock x:Name="KeyError" Margin="0,6,0,0" FontSize="11" Foreground="#F87171" TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock Margin="0,16,0,0" Text="Model" FontWeight="SemiBold" />
            <ComboBox x:Name="ModelBox" Margin="0,8,0,0" IsEditable="True" />

            <CheckBox x:Name="AiCheck" Margin="0,16,0,0" Content="Mark as AI-generated content" />

            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <ui:Button DockPanel.Dock="Right" Content="Save" Appearance="Primary" Click="OnSave" />
                <ui:Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            </DockPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
