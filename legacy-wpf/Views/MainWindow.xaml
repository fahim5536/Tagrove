<ui:FluentWindow x:Class="StockMeta.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:StockMeta.Converters"
                 Title="StockMeta"
                 Width="1280" Height="800"
                 MinWidth="1020" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 AllowDrop="True"
                 Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="StockMeta" />

        <Border Grid.Row="1" Padding="16,4,16,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="Add images" Command="{Binding AddImagesCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Generate all" Appearance="Primary" Command="{Binding GenerateAllCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                </StackPanel>
                <ui:Button Content="Settings" DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding OpenSettingsCommand}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Margin="16,0,16,8" Padding="12,8" CornerRadius="6"
                Background="#26FBBF24" BorderBrush="#66FBBF24" BorderThickness="1"
                Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Open Settings" Command="{Binding OpenSettingsCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Margin="16,0,16,8" Padding="12,6" CornerRadius="6" Background="#1F000000"
                Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Generating metadata" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ProgressBar Width="260" Height="6" Maximum="100" Value="{Binding Percent}" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.8">
                    <Run Text="{Binding DoneCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <ScrollViewer Padding="16,4,16,8" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="235" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="56" Height="56" CornerRadius="4" Background="#22000000">
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#F87171" TextWrapping="Wrap"
                                                   Text="{Binding Error}"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <TextBox Grid.Column="2" Margin="0,0,12,0" VerticalContentAlignment="Top"
                                             AcceptsReturn="False"
                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBox Grid.Column="3" Margin="0,0,12,0" Height="78" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             Text="{Binding KeywordsText, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Grid.Column="4">
                                        <DockPanel LastChildFill="False">
                                            <ui:Button DockPanel.Dock="Right" Content="Remove"
                                                       Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button DockPanel.Dock="Right" Content="Regenerate" Margin="0,0,8,0"
                                                       Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"
                                                       IsEnabled="{Binding DataContext.NotRunning, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="999" Padding="8,1">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" />
                                            </Border>
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.75" FontSize="11">
                                                <Run Text="{Binding KeywordCount, Mode=OneWay}" /><Run Text=" keywords" />
                                            </TextBlock>
                                        </StackPanel>
                                        <ComboBox Margin="0,8,0,0"
                                                  ItemsSource="{Binding CategoryOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Category}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{Binding IssueBrush}" TextWrapping="Wrap"
                                                   Text="{Binding IssueText}"
                                                   Visibility="{Binding HasIssue, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Text="No images yet" />
                    <TextBlock Margin="0,6,0,0" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Drag &amp; drop JPG, PNG or WEBP files, or click Add images." />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="5" BorderBrush="#22000000" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Opacity="0.65"
                           Text="{Binding Items.Count, StringFormat={}{0} image(s)}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border Grid.RowSpan="6" Margin="10" CornerRadius="10"
                Background="#663B82F6" BorderBrush="#993B82F6" BorderThickness="3"
                IsHitTestVisible="False"
                Visibility="{Binding IsDragging, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Drop images to add them" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</ui:FluentWindow>
